<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain net8 console that compiles the Rhino-free maths in and checks it. Run with: dotnet run, project Tests/FieldMath.Tests -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>SYSLIB0014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Utils\FieldMath.cs" />
    <Compile Include="..\..\Utils\VectorField.cs" />
    <Compile Include="..\..\Utils\Palettes.cs" />
    <Compile Include="..\..\Utils\ReportMetrics.cs" />
    <Compile Include="..\..\Utils\CanopyMath.cs" />
    <Compile Include="..\..\Utils\GeoTiff.cs" />
    <Compile Include="..\..\Utils\GeoProj.cs" />
    <Compile Include="..\..\Utils\SiteData.cs" />
    <None Include="fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
